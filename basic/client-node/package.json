{
  "name": "protomux-basic-client-node",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "gen:ts": "PATH=\"$PATH:./node_modules/.bin\" protoc -I.. --ts_proto_out=src/gen --ts_proto_opt=esModuleInterop=true,outputServices=none,useExactTypes=false ../proto/book_service.proto",
    "gen:clean": "rm -rf src/gen && mkdir -p src/gen && npm run gen:ts"
  },
  "dependencies": {
    "@protomux/client": "file:../../../client-js",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "ts-proto": "^2.3.0"
  }
}